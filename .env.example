# Server-side only — copy to .env.local for npm run dev, or set in Vercel.
# Guests do NOT call these; only host actions (buttons) do.

GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
VITE_HOST_WHATSAPP_NUMBER=353000000000
VITE_HOST_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/your-family-group-invite
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
